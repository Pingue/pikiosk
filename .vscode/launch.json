{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pikiosk Central",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "cwd": "${workspaceFolder}/central",
            "python": "${workspaceFolder}/venv/bin/python",
            "env": {
                "FLASK_APP": "pikiosk-central.py",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1",
                "DB_PATH": "${workspaceFolder}/data/db.sqlite3"
            },
            "args": ["run", "--port=5001", "--host=0.0.0.0"],
            "jinja": true
        },
        {
            "name": "LocalManager",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "cwd": "${workspaceFolder}/localmanager",
            "python": "${workspaceFolder}/venv/bin/python",
            "env": {
                "FLASK_APP": "localmanager.py",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "args": ["run", "--port=5002"],
            "jinja": true
        }
    ]
}
